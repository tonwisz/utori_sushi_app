            hint = "Cari bahan"
            textSize = 14f
            setSingleLine(true)
            background = null
        }
        val searchLayout = LinearLayout(context).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
            setPadding(dp(12), dp(12), dp(12), dp(12))
            layoutParams = android.widget.FrameLayout.LayoutParams(-1, -1)
        }
        searchLayout.addView(ImageView(context).apply {
            setImageResource(R.drawable.ic_search)
            imageTintList = ColorStateList.valueOf(MUTED)
            layoutParams = LinearLayout.LayoutParams(dp(20), dp(20)).apply { marginEnd = dp(8) }
        })
        searchLayout.addView(searchInput, LinearLayout.LayoutParams(0, -1, 1f))

        val searchCard = com.google.android.material.card.MaterialCardView(context).apply {
            radius = dp(10).toFloat()
            cardElevation = 0f
            strokeWidth = dp(1)
            strokeColor = 0xFFE0E0E0.toInt()
            setCardBackgroundColor(Color.WHITE)
            layoutParams = LinearLayout.LayoutParams(-1, dp(48)).apply { bottomMargin = dp(12) }
            addView(searchLayout)
        }
        contentContainer.addView(searchCard)

        // Category filter chips
        val chipGroup = com.google.android.material.chip.ChipGroup(context).apply {
            isSingleSelection = true
            isSingleLine = true
        }
        val chipScroll = HorizontalScrollView(context).apply {
            addView(chipGroup)
            isHorizontalScrollBarEnabled = false
            layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(12) }
        }
        contentContainer.addView(chipScroll)

        val listLayout = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
        }
        val scroll = ScrollView(context).apply {
            addView(listLayout)
            layoutParams = LinearLayout.LayoutParams(-1, 0, 1f)
        }
        contentContainer.addView(scroll)
        mainLayout.addView(contentContainer)

        // Bottom Button "Tambah Bahan" pinned to the very bottom
        var populateIngredients: (String) -> Unit = {}

        val bottomBar = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(16), dp(12), dp(16), dp(16))
            setBackgroundColor(Color.WHITE)
            elevation = dp(4).toFloat()
            layoutParams = LinearLayout.LayoutParams(-1, -2)
        }
        val btnAddIngredient = MaterialButton(context).apply {
            text = "Tambah Bahan"
            isAllCaps = false
            textSize = 15f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(Color.WHITE)
            backgroundTintList = ColorStateList.valueOf(GREEN)
            cornerRadius = dp(10)
            layoutParams = LinearLayout.LayoutParams(-1, dp(52))
            setOnClickListener {
                showIngredientEditor(null) {
                    populateIngredients(searchInput.text.toString())
                    refreshInventory()
                }
            }
        }
        bottomBar.addView(btnAddIngredient)
        mainLayout.addView(bottomBar)

        val dialog = MaterialAlertDialogBuilder(context, android.R.style.Theme_Material_Light_NoActionBar_Fullscreen)
            .setView(mainLayout)
            .create()

        dialog.window?.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
        dialog.window?.setBackgroundDrawable(android.graphics.drawable.ColorDrawable(Color.TRANSPARENT))

        btnBack.setOnClickListener { dialog.dismiss() }

        var selectedCategoryFilter = "Semua"

        populateIngredients = { query ->
            listLayout.removeAllViews()
            chipGroup.removeAllViews()

            val allIngredients = IngredientInventoryStore.ingredients(context)
            val categories = listOf("Semua") + IngredientInventoryStore.categories(context)

            categories.forEachIndexed { index, cat ->
                val chip = Chip(context).apply {
                    text = if (index == 0) "Semua (${allIngredients.size})" else "$cat (${allIngredients.count { it.category.equals(cat, true) }})"
                    isCheckable = true
                    isClickable = true
                    isCheckedIconVisible = false
                    setEnsureMinTouchTargetSize(false)

                    val states = arrayOf(
                        intArrayOf(android.R.attr.state_checked),
                        intArrayOf(-android.R.attr.state_checked)
                    )
                    chipBackgroundColor = ColorStateList(
                        states,
                        intArrayOf(0xFF008F89.toInt(), 0xFFE9ECE9.toInt())
                    )
                    chipStrokeColor = ColorStateList(
                        states,
                        intArrayOf(0xFF00796B.toInt(), 0xFFD5DED8.toInt())
                    )
                    chipStrokeWidth = dp(1).toFloat()
                    setTextColor(
                        ColorStateList(
                            states,
                            intArrayOf(Color.WHITE, 0xFF34423B.toInt())
                        )
                    )
                    isChecked = cat.equals(selectedCategoryFilter, true) || (index == 0 && selectedCategoryFilter == "Semua")
                    setOnClickListener {
                        selectedCategoryFilter = cat
                        populateIngredients(query)
                    }
                }
                chipGroup.addView(chip)
            }

            val filtered = allIngredients.filter { ing ->
                val matchCat = selectedCategoryFilter == "Semua" || ing.category.equals(selectedCategoryFilter, true)
                val matchQuery = query.isBlank() || ing.name.contains(query, true) || ing.baseUnit.contains(query, true)
                matchCat && matchQuery
            }.sortedBy { it.name.lowercase() }

            if (filtered.isEmpty()) {
                listLayout.addView(TextView(context).apply {
                    text = if (query.isBlank()) "Belum ada bahan. Klik 'Tambah Bahan' di bawah." else "Tidak ada bahan ditemukan"
                    textSize = 14f
                    setTextColor(MUTED)
                    setPadding(dp(16), dp(32), dp(16), dp(32))
                    gravity = Gravity.CENTER
                })
            } else {
                val card = com.google.android.material.card.MaterialCardView(context).apply {
                    radius = dp(14).toFloat()
                    cardElevation = 0f
                    strokeWidth = dp(1)
                    strokeColor = 0xFFE0E0E0.toInt()
                    setCardBackgroundColor(Color.WHITE)
                    layoutParams = LinearLayout.LayoutParams(-1, -2)
                }
                val cardContent = LinearLayout(context).apply {
                    orientation = LinearLayout.VERTICAL
                }

                filtered.forEachIndexed { index, item ->
                    val display = item.units.maxByOrNull { it.baseFactor } ?: UnitDefinition(item.baseUnit, 1.0)
                    val amount = item.stockInBase / display.baseFactor
                    val minimum = item.minimumInBase / display.baseFactor
                    val isLow = item.stockInBase <= item.minimumInBase

                    val row = LinearLayout(context).apply {
                        orientation = LinearLayout.HORIZONTAL
                        gravity = Gravity.CENTER_VERTICAL
                        setPadding(dp(18), dp(15), dp(16), dp(15))
                        minimumHeight = dp(72)
                        isClickable = true
                        isFocusable = true
                        setOnClickListener {
                            showIngredientEditor(item) {
                                populateIngredients(searchInput.text.toString())
                                refreshInventory()
                            }
                        }
                    }

                    val texts = LinearLayout(context).apply {
                        orientation = LinearLayout.VERTICAL
                        layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
                    }
                    val titleRow = LinearLayout(context).apply {
                        orientation = LinearLayout.HORIZONTAL
                        gravity = Gravity.CENTER_VERTICAL
                    }
                    titleRow.addView(TextView(context).apply {
                        text = item.name
                        textSize = 15f
                        setTypeface(typeface, Typeface.BOLD)
                        setTextColor(0xFF26332C.toInt())
                    })
                    if (isLow) {
                        titleRow.addView(TextView(context).apply {
                            text = "RESTOCK"
                            textSize = 10f
                            setTypeface(typeface, Typeface.BOLD)
                            setTextColor(Color.WHITE)
                            setPadding(dp(6), dp(2), dp(6), dp(2))
                            background = android.graphics.drawable.GradientDrawable().apply {
                                setColor(0xFFC62828.toInt())
                                cornerRadius = dp(4).toFloat()
                            }
                            layoutParams = LinearLayout.LayoutParams(-2, -2).apply { marginStart = dp(8) }
                        })
                    }
                    texts.addView(titleRow)

                    texts.addView(TextView(context).apply {
                        text = "Stok: ${number(amount)} ${display.name}  •  Min: ${number(minimum)} ${display.name}"
                        textSize = 13f
                        setTextColor(MUTED)
                        setPadding(0, dp(3), 0, 0)
                    })

                    row.addView(texts)

                    row.addView(TextView(context).apply {
                        text = "›"
                        textSize = 28f
                        setTextColor(GREEN)
                        setPadding(dp(8), 0, 0, 0)
                    })

                    cardContent.addView(row)

                    if (index < filtered.lastIndex) {
                        cardContent.addView(View(context).apply {
                            setBackgroundColor(0xFFE0E0E0.toInt())
                            layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(1)).apply {
                                marginStart = dp(18)
                                marginEnd = dp(18)
                            }
                        })
                    }
                }

                card.addView(cardContent)
                listLayout.addView(card)
            }
        }

        searchInput.addTextChangedListener(object : TextWatcher {
            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                populateIngredients(s?.toString().orEmpty())
            }
            override fun afterTextChanged(s: Editable?) {}
        })

        populateIngredients("")
        dialog.show()
    }

    private fun showRestockDialog(item: IngredientRecord) {
        val qty = input("Jumlah restock", "", true)
        val unit = spinner(item.units.map { it.name })
        val form = form().apply { addView(field("Jumlah", qty)); addView(label("Satuan pembelian")); addView(unit) }
        val dialog = MaterialAlertDialogBuilder(requireContext()).setTitle("Restock ${item.name}")
            .setView(form).setNegativeButton("Batal", null).setPositiveButton("Tambah stok", null).create()
        dialog.setOnShowListener {
            dialog.getButton(androidx.appcompat.app.AlertDialog.BUTTON_POSITIVE).setOnClickListener {
                val value = numeric(qty)
                if (value == null || value <= 0) { qty.error = "Jumlah harus lebih dari nol"; return@setOnClickListener }
                if (IngredientInventoryStore.addStock(requireContext(), item.id, value, unit.selectedItem.toString())) {
                    dialog.dismiss(); refreshInventory()
                    Toast.makeText(requireContext(), "Stok ${item.name} bertambah", Toast.LENGTH_SHORT).show()
                }
            }
        }
        dialog.show()
    }



