    private fun showMultiIngredientRecipeEditor(product: Product, ingredients: List<IngredientRecord>) {
        val context = requireContext()
        val existingRecipes = IngredientInventoryStore.recipes(context).filter { it.productName.equals(product.name, true) }
        val ingredientMap = ingredients.associateBy { it.id }

        val mainLayout = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
        }

        // Custom Title Header (Theme Green background, White text)
        val titleBar = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(GREEN)
            setPadding(dp(24), dp(18), dp(24), dp(18))
        }
        titleBar.addView(TextView(context).apply {
            text = "Tambah Resep"
            textSize = 18f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(Color.WHITE)
        })
        titleBar.addView(TextView(context).apply {
            text = product.name
            textSize = 14f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(Color.WHITE)
            setPadding(0, dp(2), 0, 0)
        })
        mainLayout.addView(titleBar)

        val formContainer = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(20), dp(12), dp(20), dp(12))
        }

        formContainer.addView(TextView(context).apply {
            text = "Bahan Baku"
            textSize = 16f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(0xFF26332C.toInt())
        })
        formContainer.addView(TextView(context).apply {
            text = "Tambah bahan baku yang dibutuhkan untuk menghasilkan satu produk."
            textSize = 12f
            setTextColor(MUTED)
            setPadding(0, dp(2), 0, dp(12))
        })

        val itemsLayout = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
        }

        val recipeRows = mutableListOf<RecipeItemRow>()

        fun addRow(ing: IngredientRecord, initialQty: Double = 1.0, selectedUnit: String = ing.baseUnit) {
            val rowCard = com.google.android.material.card.MaterialCardView(context).apply {
                radius = dp(10).toFloat()
                cardElevation = 0f
                strokeWidth = dp(1)
                strokeColor = 0xFFE0E0E0.toInt()
                setCardBackgroundColor(Color.WHITE)
                layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(10) }
            }

            val rowContent = LinearLayout(context).apply {
                orientation = LinearLayout.VERTICAL
                setPadding(dp(14), dp(12), dp(14), dp(12))
            }

            // Top Row: Ingredient Name (Bold)
            rowContent.addView(TextView(context).apply {
                text = ing.name
                textSize = 15f
                setTypeface(typeface, Typeface.BOLD)
                setTextColor(0xFF26332C.toInt())
                layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(6) }
            })

            // Bottom Row: Compact Quantity Input + Expanded Unit Spinner + Remove Button (X)
            val inputRow = LinearLayout(context).apply {
                orientation = LinearLayout.HORIZONTAL
                gravity = Gravity.CENTER_VERTICAL
            }

            val takaranInput = EditText(context).apply {
                hint = "1"
                setText(if (initialQty > 0) number(initialQty) else "")
                inputType = InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_FLAG_DECIMAL
                textSize = 14f
                setSingleLine(true)
                gravity = Gravity.CENTER
                filters = arrayOf(android.text.InputFilter.LengthFilter(6))
                layoutParams = LinearLayout.LayoutParams(dp(64), dp(40)).apply { marginEnd = dp(8) }
            }
            inputRow.addView(takaranInput)

            val unitSpinner = Spinner(context).apply {
                val unitNames = ing.units.map { it.name }
                adapter = ArrayAdapter(context, android.R.layout.simple_spinner_dropdown_item, unitNames)
                val unitIdx = unitNames.indexOfFirst { it.equals(selectedUnit, true) }
                if (unitIdx >= 0) setSelection(unitIdx)
                layoutParams = LinearLayout.LayoutParams(0, dp(40), 1f).apply { marginEnd = dp(8) }
            }
            inputRow.addView(unitSpinner)

            val btnRemove = TextView(context).apply {
                text = "✕"
                textSize = 18f
                setTextColor(0xFFC62828.toInt())
                setPadding(dp(6), dp(4), dp(6), dp(4))
                isClickable = true
                isFocusable = true
            }
            inputRow.addView(btnRemove)

            rowContent.addView(inputRow)
            rowCard.addView(rowContent)

            val itemRow = RecipeItemRow(ing, takaranInput, unitSpinner, rowCard)
            recipeRows.add(itemRow)

            btnRemove.setOnClickListener {
                itemsLayout.removeView(rowCard)
                recipeRows.remove(itemRow)
            }

            itemsLayout.addView(rowCard)
        }

        if (existingRecipes.isNotEmpty()) {
            existingRecipes.forEach { rec ->
                ingredientMap[rec.ingredientId]?.let { ing ->
                    addRow(ing, rec.quantity, rec.unit)
                }
            }
        }

        formContainer.addView(itemsLayout)

        val btnAddBahan = MaterialButton(context, null, com.google.android.material.R.attr.materialButtonOutlinedStyle).apply {
            text = "+ Tambah Bahan Baku"
            isAllCaps = false
            setTextColor(GREEN)
            strokeColor = ColorStateList.valueOf(GREEN)
            cornerRadius = dp(8)
            layoutParams = LinearLayout.LayoutParams(-1, dp(48)).apply { topMargin = dp(4); bottomMargin = dp(16) }
            setOnClickListener {
                val mainLayout = LinearLayout(context).apply {
                    orientation = LinearLayout.VERTICAL
                }

                // Custom Title Header (Theme Green background, White text)
                val titleBar = LinearLayout(context).apply {
                    orientation = LinearLayout.VERTICAL
                    setBackgroundColor(GREEN)
                    setPadding(dp(24), dp(18), dp(24), dp(18))
                }
                titleBar.addView(TextView(context).apply {
                    text = "Pilih Bahan Baku"
                    textSize = 18f
                    setTypeface(typeface, Typeface.BOLD)
                    setTextColor(Color.WHITE)
                })
                titleBar.addView(TextView(context).apply {
                    text = "Pilih bahan baku untuk resep menu ini"
                    textSize = 12f
                    setTextColor(0xFFE0F2F1.toInt())
                    setPadding(0, dp(2), 0, 0)
                })
                mainLayout.addView(titleBar)

                val contentContainer = LinearLayout(context).apply {
                    orientation = LinearLayout.VERTICAL
                    setPadding(dp(16), dp(12), dp(16), dp(12))
                }

                // Category filter chips
                val chipGroup = com.google.android.material.chip.ChipGroup(context).apply {
                    isSingleSelection = true
                    isSingleLine = true
                }
                val chipScroll = HorizontalScrollView(context).apply {
                    addView(chipGroup)
                    isHorizontalScrollBarEnabled = false
                    layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(12) }
                }
                contentContainer.addView(chipScroll)

                val itemsLayout = LinearLayout(context).apply {
                    orientation = LinearLayout.VERTICAL
                }
                val checkboxes = mutableListOf<Pair<IngredientRecord, android.widget.CheckBox>>()

                val selectScroll = ScrollView(context).apply {
                    addView(itemsLayout)
                    layoutParams = LinearLayout.LayoutParams(-1, dp(300))
                }
                contentContainer.addView(selectScroll)
                mainLayout.addView(contentContainer)

                val selectDialog = MaterialAlertDialogBuilder(context)
                    .setView(mainLayout)
                    .setNegativeButton("Batal", null)
                    .setPositiveButton("Pilih", null)
                    .create()

                fun populateCheckboxes(catFilter: String) {
                    itemsLayout.removeAllViews()
                    chipGroup.removeAllViews()
                    checkboxes.clear()

                    val sortedIngredients = ingredients.sortedBy { it.name.lowercase() }
                    val categories = listOf("Semua") + IngredientInventoryStore.categories(context)

                    categories.forEachIndexed { index, cat ->
                        val chip = Chip(context).apply {
                            text = if (index == 0) "Semua (${sortedIngredients.size})" else "$cat (${sortedIngredients.count { it.category.equals(cat, true) }})"
                            isCheckable = true
                            isClickable = true
                            isCheckedIconVisible = false
                            setEnsureMinTouchTargetSize(false)

                            val states = arrayOf(
                                intArrayOf(android.R.attr.state_checked),
                                intArrayOf(-android.R.attr.state_checked)
                            )
                            chipBackgroundColor = ColorStateList(
                                states,
                                intArrayOf(0xFF008F89.toInt(), 0xFFE9ECE9.toInt())
                            )
                            chipStrokeColor = ColorStateList(
                                states,
                                intArrayOf(0xFF00796B.toInt(), 0xFFD5DED8.toInt())
                            )
                            chipStrokeWidth = dp(1).toFloat()
                            setTextColor(
                                ColorStateList(
                                    states,
                                    intArrayOf(Color.WHITE, 0xFF34423B.toInt())
                                )
                            )
                            isChecked = cat.equals(catFilter, true) || (index == 0 && catFilter == "Semua")
                            setOnClickListener {
                                populateCheckboxes(cat)
                            }
                        }
                        chipGroup.addView(chip)
                    }

                    val filtered = sortedIngredients.filter { ing ->
                        catFilter == "Semua" || ing.category.equals(catFilter, true)
                    }

                    if (filtered.isEmpty()) {
                        itemsLayout.addView(TextView(context).apply {
                            text = "Tidak ada bahan dalam kategori ini"
                            textSize = 14f
                            setTextColor(MUTED)
                            setPadding(dp(16), dp(20), dp(16), dp(20))
                            gravity = Gravity.CENTER
                        })
                    } else {
                        filtered.forEach { ing ->
                            val alreadyAdded = recipeRows.any { it.ingredient.id == ing.id }
                            val cb = android.widget.CheckBox(context).apply {
                                text = if (alreadyAdded) "${ing.name} (Sudah ditambahkan)" else ing.name
                                textSize = 14f
                                setTextColor(if (alreadyAdded) MUTED else 0xFF26332C.toInt())
                                isChecked = false
                                isEnabled = !alreadyAdded
                                setPadding(0, dp(8), 0, dp(8))
                            }
                            checkboxes.add(ing to cb)
                            itemsLayout.addView(cb)
                        }
                    }
                }

                populateCheckboxes("Semua")

                selectDialog.setOnShowListener {
                    selectDialog.getButton(androidx.appcompat.app.AlertDialog.BUTTON_POSITIVE).setOnClickListener {
                        val selected = checkboxes.filter { it.second.isChecked }.map { it.first }
                        if (selected.isEmpty()) {
                            Toast.makeText(context, "Pilih minimal satu bahan baku", Toast.LENGTH_SHORT).show()
                            return@setOnClickListener
                        }
                        selected.forEach { ing ->
                            if (recipeRows.none { it.ingredient.id == ing.id }) {
                                addRow(ing, 1.0, ing.baseUnit)
                            }
                        }
                        selectDialog.dismiss()
                    }
                }
                selectDialog.show()
            }
        }
        formContainer.addView(btnAddBahan)

        val scroll = ScrollView(context).apply {
            addView(formContainer)
            layoutParams = LinearLayout.LayoutParams(-1, dp(400))
        }
        mainLayout.addView(scroll)

        val dialog = MaterialAlertDialogBuilder(context)
            .setView(mainLayout)
            .setNegativeButton("Batal", null)
            .setPositiveButton("Simpan", null)
            .create()

        dialog.setOnShowListener {
            dialog.getButton(androidx.appcompat.app.AlertDialog.BUTTON_POSITIVE).setOnClickListener {
                if (recipeRows.isEmpty()) {
                    Toast.makeText(context, "Tambahkan minimal 1 bahan baku", Toast.LENGTH_SHORT).show()
                    return@setOnClickListener
                }
                for (row in recipeRows) {
                    val qty = row.qtyEdit.text.toString().trim().replace(',', '.').toDoubleOrNull()
                    if (qty == null || qty <= 0) {
                        row.qtyEdit.error = "Takaran valid diperlukan"
                        Toast.makeText(context, "Periksa kembali takaran bahan", Toast.LENGTH_SHORT).show()
                        return@setOnClickListener
                    }
                }

                existingRecipes.forEach { oldRec ->
                    IngredientInventoryStore.removeRecipe(context, product.name, oldRec.ingredientId)
                }

                recipeRows.forEach { row ->
                    val qty = row.qtyEdit.text.toString().trim().replace(',', '.').toDoubleOrNull() ?: 1.0
                    val unit = row.unitSpinner.selectedItem?.toString() ?: row.ingredient.baseUnit
                    IngredientInventoryStore.saveRecipe(
                        context,
                        RecipeRecord(product.name, row.ingredient.id, qty, unit)
                    )
                }

                Toast.makeText(context, "Resep ${product.name} berhasil disimpan!", Toast.LENGTH_SHORT).show()
                dialog.dismiss()
                refreshInventory()
            }
        }
        dialog.show()
    }

