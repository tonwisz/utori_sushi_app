class StockManagementFragment : Fragment() {
    private var _binding: FragmentStockManagementBinding? = null
    private val binding get() = _binding!!

    override fun onCreateView(inflater: LayoutInflater, container: ViewGroup?, savedInstanceState: Bundle?): View {
        _binding = FragmentStockManagementBinding.inflate(inflater, container, false)
        return binding.root
    }

    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        binding.rowAddIngredient.setOnClickListener { showKelolaBahanDashboard() }
        binding.rowManageRecipes.setOnClickListener { showRecipeManager() }
        binding.rowStockReport.setOnClickListener { showStockReport() }
        refreshInventory()
    }

    private fun refreshInventory() {
        val items = IngredientInventoryStore.ingredients(requireContext())
        val low = items.count { it.stockInBase <= it.minimumInBase }
        binding.tvInventorySummary.text = "${items.size} bahan terdaftar  ·  $low perlu restock  ·  ${IngredientInventoryStore.recipes(requireContext()).map { it.productName }.distinct().size} menu punya resep"
    }

    private fun showIngredientEditor(existing: IngredientRecord?, onSaved: (() -> Unit)? = null) {
        val context = requireContext()
        val preferred = existing?.units?.maxByOrNull { it.baseFactor } ?: existing?.let { UnitDefinition(it.baseUnit, 1.0) }

        val name = input("Nama bahan", existing?.name.orEmpty())
        val baseUnitInput = input("Satuan dasar (g, ml, pcs)", existing?.baseUnit ?: "g")
        val bigUnitInput = input("Satuan besar (kg, liter, pack)", preferred?.name ?: "kg")

        val conversionFactorValue = preferred?.let { number(it.baseFactor) } ?: "1000"
        val conversionInput = input("Nilai konversi", if (existing != null) conversionFactorValue else "1000", true)

        val categories = IngredientInventoryStore.categories(context)
        val categorySpinner = spinner(categories).apply {
            val index = categories.indexOfFirst { it.equals(existing?.category ?: "Lainnya", true) }
            if (index >= 0) setSelection(index)
        }

        val currentBigUnit = bigUnitInput.text.toString().trim().ifBlank { "kg" }
        val stock = input("Stok awal ($currentBigUnit)", existing?.let { number(it.stockInBase / (preferred?.baseFactor ?: 1.0)) } ?: "", true)
        val min = input("Batas minimum ($currentBigUnit)", existing?.let { number(it.minimumInBase / (preferred?.baseFactor ?: 1.0)) } ?: "", true)

        val mainLayout = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
        }

        // Custom Title Header (Theme Green background, White text)
        val titleBar = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(GREEN)
            setPadding(dp(24), dp(18), dp(24), dp(18))
        }
        titleBar.addView(TextView(context).apply {
            text = if (existing == null) "Tambah bahan" else "Edit bahan & satuan"
            textSize = 18f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(Color.WHITE)
        })
        titleBar.addView(TextView(context).apply {
            text = "Kelola informasi bahan, satuan konversi, dan stok awal"
            textSize = 12f
            setTextColor(0xFFE0F2F1.toInt())
            setPadding(0, dp(2), 0, 0)
        })
        mainLayout.addView(titleBar)

        val content = form()
        content.addView(field("Nama bahan", name))

        val categoryHeaderRow = LinearLayout(context).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
            setPadding(0, dp(4), 0, dp(4))
        }
        categoryHeaderRow.addView(TextView(context).apply {
            text = "Kategori bahan"
            textSize = 13f
            setTextColor(MUTED)
            layoutParams = LinearLayout.LayoutParams(0, -2, 1f)
        })

        val btnManageCat = TextView(context).apply {
            text = "+ Tambah / Ubah"
            textSize = 12f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(GREEN)
            setPadding(dp(8), dp(4), dp(8), dp(4))
            isClickable = true
            isFocusable = true
            setOnClickListener {
                showCategoryManager {
                    val updatedCategories = IngredientInventoryStore.categories(context)
                    categorySpinner.adapter = ArrayAdapter(context, android.R.layout.simple_spinner_dropdown_item, updatedCategories)
                    val newIndex = updatedCategories.indexOfFirst { it.equals(existing?.category ?: "Lainnya", true) }
                    if (newIndex >= 0) categorySpinner.setSelection(newIndex)
                }
            }
        }
        categoryHeaderRow.addView(btnManageCat)

        content.addView(categoryHeaderRow)
        content.addView(categorySpinner)

        // Side-by-side units row
        val unitsRow = LinearLayout(context).apply {
            orientation = LinearLayout.HORIZONTAL
            layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(4) }
        }
        val leftField = field("Satuan dasar (resep)", baseUnitInput).apply {
            layoutParams = LinearLayout.LayoutParams(0, -2, 1f).apply { marginEnd = dp(6) }
        }
        val rightField = field("Satuan besar (grosir)", bigUnitInput).apply {
            layoutParams = LinearLayout.LayoutParams(0, -2, 1f).apply { marginStart = dp(6) }
        }
        unitsRow.addView(leftField)
        unitsRow.addView(rightField)
        content.addView(unitsRow)

        // Conversion helper row
        content.addView(label("Faktor Konversi Satuan"))

        val convRow = LinearLayout(context).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
            setPadding(dp(12), dp(8), dp(12), dp(8))
            background = roundedBg(0xFFF0F4F1.toInt(), dp(8).toFloat())
            layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(12) }
        }

        val tvBigUnitLabel = TextView(context).apply {
            text = "1 ${bigUnitInput.text.toString().ifBlank { "kg" }} = "
            textSize = 14f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(0xFF26332C.toInt())
        }
        convRow.addView(tvBigUnitLabel)

        conversionInput.layoutParams = LinearLayout.LayoutParams(dp(90), dp(40)).apply {
            marginStart = dp(6)
            marginEnd = dp(6)
        }
        conversionInput.gravity = Gravity.CENTER
        conversionInput.background = roundedBg(Color.WHITE, dp(6).toFloat())
        convRow.addView(conversionInput)

        val tvBaseUnitLabel = TextView(context).apply {
            text = baseUnitInput.text.toString().ifBlank { "g" }
            textSize = 14f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(0xFF26332C.toInt())
        }
        convRow.addView(tvBaseUnitLabel)

        content.addView(convRow)

        // TextWatcher to live update labels
        val updateLabels = {
            val bigStr = bigUnitInput.text.toString().trim().ifBlank { "kg" }
            val baseStr = baseUnitInput.text.toString().trim().ifBlank { "g" }
            tvBigUnitLabel.text = "1 $bigStr = "
            tvBaseUnitLabel.text = baseStr
            (stock.parent as? TextInputLayout)?.hint = "Stok awal ($bigStr)"
            (min.parent as? TextInputLayout)?.hint = "Batas minimum ($bigStr)"
        }

        val unitWatcher = object : TextWatcher {
            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) { updateLabels() }
            override fun afterTextChanged(s: Editable?) {}
        }
        baseUnitInput.addTextChangedListener(unitWatcher)
        bigUnitInput.addTextChangedListener(unitWatcher)

        content.addView(field("Stok awal", stock))
        content.addView(field("Batas minimum", min))

        val scroll = ScrollView(context).apply {
            addView(content)
            layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(400))
        }
        mainLayout.addView(scroll)

        val dialog = MaterialAlertDialogBuilder(context)
            .setView(mainLayout)
            .setNegativeButton("Batal", null)
            .setPositiveButton("Simpan", null)
            .create()

        dialog.setOnShowListener {
            dialog.getButton(androidx.appcompat.app.AlertDialog.BUTTON_POSITIVE).setOnClickListener {
                val itemName = name.text.toString().trim()
                val baseUnit = baseUnitInput.text.toString().trim()
                val bigUnit = bigUnitInput.text.toString().trim().ifBlank { baseUnit }
                val convFactor = numeric(conversionInput) ?: 1.0

                val stockQty = numeric(stock)
                val minQty = numeric(min)

                if (itemName.isBlank() || baseUnit.isBlank()) {
                    name.error = if (itemName.isBlank()) "Nama wajib diisi" else null
                    baseUnitInput.error = if (baseUnit.isBlank()) "Satuan dasar wajib diisi" else null
                    return@setOnClickListener
                }
                if (stockQty == null || minQty == null || stockQty < 0 || minQty < 0) {
                    stock.error = "Isi stok dan batas minimum dengan angka valid"; return@setOnClickListener
                }
                if (convFactor <= 0) {
                    conversionInput.error = "Faktor konversi harus > 0"; return@setOnClickListener
                }

                val units = mutableListOf<UnitDefinition>()
                units.add(UnitDefinition(baseUnit, 1.0))
                if (!bigUnit.equals(baseUnit, true)) {
                    units.add(UnitDefinition(bigUnit, convFactor))
                }
                val preferredUnit = units.maxByOrNull { it.baseFactor } ?: UnitDefinition(baseUnit, 1.0)
                val factor = preferredUnit.baseFactor

                IngredientInventoryStore.saveIngredient(
                    context,
                    IngredientRecord(existing?.id ?: UUID.randomUUID().toString(), itemName, baseUnit,
                        stockQty * factor, minQty * factor, units, categorySpinner.selectedItem.toString())
                )
                dialog.dismiss()
                refreshInventory()
                onSaved?.invoke()
            }
        }
        dialog.show()
    }

