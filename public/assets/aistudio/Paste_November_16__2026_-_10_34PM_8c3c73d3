        fun populateRecipes(query: String) {
            listLayout.removeAllViews()
            lifecycleScope.launch {
                val products = withContext(Dispatchers.IO) {
                    AppDatabase.getDatabase(context).productDao().getAllProducts().first()
                }
                val recipesByProduct = IngredientInventoryStore.recipes(context).groupBy { it.productName }

                val filteredProducts = products.filter { recipesByProduct.containsKey(it.name) && it.name.contains(query, true) }

                withContext(Dispatchers.Main) {
                    if (filteredProducts.isEmpty()) {
                        listLayout.addView(TextView(context).apply {
                            text = if (query.isBlank()) "Belum ada resep produk. Klik 'Tambah Resep' di bawah." else "Tidak ada resep ditemukan"
                            textSize = 14f
                            setTextColor(MUTED)
                            setPadding(dp(16), dp(32), dp(16), dp(32))
                            gravity = Gravity.CENTER
                        })
                    } else {
                        val card = com.google.android.material.card.MaterialCardView(context).apply {
                            radius = dp(14).toFloat()
                            cardElevation = 0f
                            strokeWidth = dp(1)
                            strokeColor = 0xFFE0E0E0.toInt()
                            setCardBackgroundColor(Color.WHITE)
                            layoutParams = LinearLayout.LayoutParams(-1, -2)
                        }
                        val cardContent = LinearLayout(context).apply {
                            orientation = LinearLayout.VERTICAL
                        }

                        filteredProducts.forEachIndexed { index, product ->
                            val count = recipesByProduct[product.name]?.size ?: 0
                            val row = LinearLayout(context).apply {
                                orientation = LinearLayout.HORIZONTAL
                                gravity = Gravity.CENTER_VERTICAL
                                setPadding(dp(18), dp(15), dp(16), dp(15))
                                minimumHeight = dp(72)
                                isClickable = true
                                isFocusable = true
                                setOnClickListener {
                                    dialog.dismiss()
                                    showMultiIngredientRecipeEditor(product, IngredientInventoryStore.ingredients(context))
                                }
                            }

                            // Product Name (Clean list without photo or initials badge)
                            row.addView(TextView(context).apply {
                                text = product.name
                                textSize = 15f
                                setTypeface(typeface, Typeface.BOLD)
                                setTextColor(0xFF26332C.toInt())
                                layoutParams = LinearLayout.LayoutParams(0, -2, 1f)
                            })

                            val rightContainer = LinearLayout(context).apply {
                                orientation = LinearLayout.HORIZONTAL
                                gravity = Gravity.CENTER_VERTICAL
                            }
                            rightContainer.addView(TextView(context).apply {
                                text = "$count bahan baku"
                                textSize = 13f
                                setTextColor(MUTED)
                                setPadding(0, 0, dp(8), 0)
                            })
                            rightContainer.addView(TextView(context).apply {
                                text = "›"
                                textSize = 28f
                                setTextColor(GREEN)
                            })
                            row.addView(rightContainer)

                            cardContent.addView(row)

                            if (index < filteredProducts.lastIndex) {
                                cardContent.addView(View(context).apply {
                                    setBackgroundColor(0xFFE0E0E0.toInt())
                                    layoutParams = LinearLayout.LayoutParams(-1, dp(1)).apply {
                                        marginStart = dp(18)
                                        marginEnd = dp(18)
                                    }
                                })
                            }
                        }

                        card.addView(cardContent)
                        listLayout.addView(card)
                    }
                }
            }
        }

        searchInput.addTextChangedListener(object : TextWatcher {
            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                populateRecipes(s?.toString().orEmpty())
            }
            override fun afterTextChanged(s: Editable?) {}
        })

        populateRecipes("")
        dialog.show()
    }

    private fun loadProductsAndOpenRecipeSelector() {
        lifecycleScope.launch {
            val products = withContext(Dispatchers.IO) {
                AppDatabase.getDatabase(requireContext()).productDao().getAllProducts().first()
            }
            val context = requireContext()
            if (products.isEmpty()) {
                MaterialAlertDialogBuilder(context)
                    .setTitle("Belum ada produk")
                    .setMessage("Silakan tambah produk terlebih dahulu untuk membuat resep.")
                    .setPositiveButton("OK", null)
                    .show()
                return@launch
            }
            showSelectProductDialog(products)
        }
    }

