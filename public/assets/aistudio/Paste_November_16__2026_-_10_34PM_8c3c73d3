    private fun showEditCategoryDialog(oldCategory: String, onUpdated: () -> Unit) {
        val context = requireContext()
        val nameInput = input("Nama kategori", oldCategory)

        val mainLayout = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
        }

        // Custom Title Header (Theme Green background, White text)
        val titleBar = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(GREEN)
            setPadding(dp(24), dp(18), dp(24), dp(18))
        }
        titleBar.addView(TextView(context).apply {
            text = "Ubah Nama Kategori"
            textSize = 18f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(Color.WHITE)
        })
        titleBar.addView(TextView(context).apply {
            text = "Kategori: $oldCategory"
            textSize = 12f
            setTextColor(0xFFE0F2F1.toInt())
            setPadding(0, dp(2), 0, 0)
        })
        mainLayout.addView(titleBar)

        val content = form()
        content.addView(field("Nama kategori baru", nameInput))
        mainLayout.addView(content)

        val dialog = MaterialAlertDialogBuilder(context)
            .setView(mainLayout)
            .setNegativeButton("Batal", null)
            .setPositiveButton("Simpan", null)
            .create()

        dialog.setOnShowListener {
            dialog.getButton(androidx.appcompat.app.AlertDialog.BUTTON_POSITIVE).setOnClickListener {
                val newName = nameInput.text.toString().trim()
                if (newName.isBlank()) {
                    nameInput.error = "Nama wajib diisi"
                    return@setOnClickListener
                }
                if (!IngredientInventoryStore.updateCategory(context, oldCategory, newName)) {
                    nameInput.error = "Kategori sudah ada atau tidak valid"
                    return@setOnClickListener
                }
                Toast.makeText(context, "Kategori diubah menjadi '$newName'", Toast.LENGTH_SHORT).show()
                dialog.dismiss()
                onUpdated()
            }
        }
        dialog.show()
    }

    private fun showStockReport() {
        val context = requireContext()
        val categories = listOf("Semua kategori") + IngredientInventoryStore.categories(context)

        val container = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(0, dp(4), 0, dp(4))
        }

        // Custom Title Header (Theme Green background, White text)
        val titleBar = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(0xFF008F89.toInt()) // COLOR_GREEN
            setPadding(dp(24), dp(18), dp(24), dp(18))
        }
        titleBar.addView(TextView(context).apply {
            text = "Filter laporan stok"
            textSize = 18f
            setTypeface(typeface, Typeface.BOLD)
            setTextColor(Color.WHITE)
        })
        titleBar.addView(TextView(context).apply {
            text = "Pilih kategori bahan untuk melihat laporan stok"
