    private fun printStockReport(category: String, items: List<IngredientRecord>) {
        val context = requireContext()
        val printers = BluetoothPrinterStore.all(context).filter { it.purpose == "Struk" || it.purpose == "Laporan" }
        val printer = printers.firstOrNull { it.isDefault } ?: printers.firstOrNull()
        if (printer == null) {
            Toast.makeText(context, "Printer ESC/POS belum terdaftar. Atur di Pengaturan Printer.", Toast.LENGTH_LONG).show()
            return
        }
        val lines = buildList {
            add("LAPORAN STOK · $category")
            add("Waktu: " + java.text.SimpleDateFormat("EEEE, dd/MM/yyyy HH:mm", Locale("id", "ID")).format(Date()))
            add("--------------------------------")
            items.sortedBy { it.name }.forEach { item ->
                val amount = item.stockInBase
                val min = item.minimumInBase
                val unitName = item.baseUnit
                add(item.name)
                add("Stok: ${number(amount)} $unitName | Min: ${number(min)} $unitName")
                if (item.stockInBase <= item.minimumInBase) add("  ** PERLU RESTOCK **")
                add("--------------------------------")
            }
            add("Total: ${items.size} bahan")
        }
        lifecycleScope.launch {
            BluetoothPrintService.printLines(context, printer, lines)
                .onSuccess { Toast.makeText(context, "Laporan dicetak ke ${printer.name}.", Toast.LENGTH_SHORT).show() }
                .onFailure { error -> Toast.makeText(context, "Gagal mencetak: ${error.localizedMessage ?: "Periksa koneksi printer"}", Toast.LENGTH_LONG).show() }
        }
    }

    private fun generateStockReportPdf(context: android.content.Context, category: String, items: List<IngredientRecord>): File? {
        try {
            val profile = CompanySettings.getProfile(context)
            val outletName = profile.name.ifBlank { "Sarimanah" }

            val pdfDocument = android.graphics.pdf.PdfDocument()
            val pageInfo = android.graphics.pdf.PdfDocument.PageInfo.Builder(595, 842, 1).create()
            val page = pdfDocument.startPage(pageInfo)
            val canvas = page.canvas
            val paint = android.graphics.Paint().apply {
                color = android.graphics.Color.BLACK
                textSize = 11f
            }
            val headerPaint = android.graphics.Paint().apply {
                color = android.graphics.Color.BLACK
                textSize = 12f
                isFakeBoldText = true
            }
            val titlePaint = android.graphics.Paint().apply {
                color = 0xFF008F89.toInt()
                textSize = 18f
                isFakeBoldText = true
            }

            var y = 40f
            canvas.drawText("Outlet : $outletName", 40f, y, headerPaint)
            y += 22f
            canvas.drawText("LAPORAN STOK · $category", 40f, y, titlePaint)
            y += 24f
            paint.textSize = 11f
            canvas.drawText("Waktu: " + java.text.SimpleDateFormat("EEEE, dd/MM/yyyy HH:mm", Locale("id", "ID")).format(Date()), 40f, y, paint)
            y += 20f
            canvas.drawText("------------------------------------------------------------------------------------------------------------------------", 40f, y, paint)
            y += 20f

            // Table Header 3 columns
            canvas.drawText("Bahan", 40f, y, headerPaint)
            canvas.drawText("Stok Saat Ini", 320f, y, headerPaint)
            canvas.drawText("Stok Minimal", 450f, y, headerPaint)
            y += 18f
            canvas.drawText("------------------------------------------------------------------------------------------------------------------------", 40f, y, paint)
            y += 20f

            items.sortedBy { it.name }.forEach { item ->
                if (y > 780f) return@forEach
                val amount = item.stockInBase
                val min = item.minimumInBase
                val unitName = item.baseUnit
                val status = if (item.stockInBase <= item.minimumInBase) " [RESTOCK]" else ""

                canvas.drawText(item.name, 40f, y, paint)
                canvas.drawText("${number(amount)} $unitName", 320f, y, paint)
                canvas.drawText("${number(min)} $unitName$status", 450f, y, paint)
                y += 20f
            }

            y += 10f
            canvas.drawText("------------------------------------------------------------------------------------------------------------------------", 40f, y, paint)
            y += 20f
            canvas.drawText("Total: ${items.size} bahan", 40f, y, paint)

            pdfDocument.finishPage(page)

            val file = File(context.cacheDir, "Laporan_Stok_${category.replace(" ", "_")}.pdf")
            pdfDocument.writeTo(java.io.FileOutputStream(file))
            pdfDocument.close()
            return file
        } catch (e: Exception) {
            e.printStackTrace()
            return null
        }
    }

