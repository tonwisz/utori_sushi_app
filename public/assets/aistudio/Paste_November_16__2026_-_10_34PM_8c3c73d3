                d.dismiss()
                onDismiss?.invoke()
            }
            .setOnDismissListener {
                onDismiss?.invoke()
            }
            .create()

        fun populateList() {
            listLayout.removeAllViews()
            val categories = IngredientInventoryStore.categories(context)

            val card = com.google.android.material.card.MaterialCardView(context).apply {
                radius = dp(12).toFloat()
                cardElevation = 0f
                strokeWidth = dp(1)
                strokeColor = 0xFFE0E0E0.toInt()
                setCardBackgroundColor(Color.WHITE)
                layoutParams = LinearLayout.LayoutParams(-1, -2)
            }
            val cardContent = LinearLayout(context).apply {
                orientation = LinearLayout.VERTICAL
            }

            categories.forEachIndexed { index, cat ->
                val row = LinearLayout(context).apply {
                    orientation = LinearLayout.HORIZONTAL
                    gravity = Gravity.CENTER_VERTICAL
                    setPadding(dp(16), dp(12), dp(16), dp(12))
                }

                row.addView(TextView(context).apply {
                    text = cat
                    textSize = 15f
                    setTypeface(typeface, Typeface.BOLD)
                    setTextColor(0xFF26332C.toInt())
                    layoutParams = LinearLayout.LayoutParams(0, -2, 1f)
                })

                val actionsRow = LinearLayout(context).apply {
                    orientation = LinearLayout.HORIZONTAL
                    gravity = Gravity.CENTER_VERTICAL
                }

                // Edit/Ubah button
                val btnEdit = TextView(context).apply {
                    text = "Ubah"
                    textSize = 13f
                    setTypeface(typeface, Typeface.BOLD)
                    setTextColor(GREEN)
                    setPadding(dp(8), dp(4), dp(8), dp(4))
                    isClickable = true
                    isFocusable = true
                    setOnClickListener {
                        showEditCategoryDialog(cat) {
                            refreshInventory()
                            populateList()
                        }
                    }
                }
                actionsRow.addView(btnEdit)

                // Delete/Hapus button (Lainnya is protected system fallback category)
                if (!cat.equals("Lainnya", true)) {
                    val btnDelete = TextView(context).apply {
                        text = "Hapus"
                        textSize = 13f
                        setTypeface(typeface, Typeface.BOLD)
                        setTextColor(0xFFC62828.toInt())
                        setPadding(dp(8), dp(4), dp(8), dp(4))
                        isClickable = true
                        isFocusable = true
                        setOnClickListener {
                            showDeleteCategoryConfirmation(cat) {
                                refreshInventory()
                                populateList()
                            }
                        }
                    }
                    actionsRow.addView(btnDelete)
                }

                row.addView(actionsRow)
                cardContent.addView(row)

                if (index < categories.lastIndex) {
                    cardContent.addView(View(context).apply {
                        setBackgroundColor(0xFFE0E0E0.toInt())
                        layoutParams = LinearLayout.LayoutParams(-1, dp(1)).apply { marginStart = dp(16); marginEnd = dp(16) }
                    })
                }
            }

            card.addView(cardContent)
            listLayout.addView(card)
        }

        btnAddCat.setOnClickListener {
            val name = etNewCategory.text.toString().trim()
            if (name.isBlank()) {
                etNewCategory.error = "Nama kategori tidak boleh kosong"
                return@setOnClickListener
            }
            if (!IngredientInventoryStore.addCategory(context, name)) {
                etNewCategory.error = "Kategori sudah ada"
                return@setOnClickListener
            }
            etNewCategory.setText("")
            Toast.makeText(context, "Kategori '$name' ditambahkan", Toast.LENGTH_SHORT).show()
            refreshInventory()
            populateList()
        }

        populateList()
        dialog.show()
    }

