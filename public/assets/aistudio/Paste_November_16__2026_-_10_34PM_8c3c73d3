            orientation = LinearLayout.VERTICAL
        }
        mainLayout.addView(titleBar)

        val scrollContent = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(0, dp(4), 0, dp(4))
        }

        val dialogBuilder = MaterialAlertDialogBuilder(context)
        lateinit var dialog: androidx.appcompat.app.AlertDialog

        categories.forEachIndexed { index, category ->
            val row = LinearLayout(context).apply {
                orientation = LinearLayout.HORIZONTAL
                gravity = Gravity.CENTER_VERTICAL
                isClickable = true
                isFocusable = true
                setPadding(dp(24), dp(15), dp(24), dp(15))
                minimumHeight = dp(56)
                setOnClickListener {
                    dialog.dismiss()
                    val selected = category
                    val items = IngredientInventoryStore.ingredients(context).let { list ->
                        if (selected == "Semua kategori") list else list.filter { it.category.equals(selected, true) }
                    }
                    val low = items.count { it.stockInBase <= it.minimumInBase }
                    val reportContainer = LinearLayout(context).apply {
                        orientation = LinearLayout.VERTICAL
                        setPadding(0, dp(4), 0, dp(4))
                    }

                    // Custom Title Header (Theme Green background, White text)
                    val reportTitleBar = LinearLayout(context).apply {
                        orientation = LinearLayout.VERTICAL
                        setBackgroundColor(0xFF008F89.toInt()) // COLOR_GREEN
                        setPadding(dp(24), dp(18), dp(24), dp(18))
                    }
                    reportTitleBar.addView(TextView(context).apply {
                        text = "Laporan stok · $selected"
                        textSize = 18f
                        setTypeface(typeface, Typeface.BOLD)
                        setTextColor(Color.WHITE)
                    })
                    reportTitleBar.addView(TextView(context).apply {
                        text = "${items.size} bahan · $low perlu restock"
                        textSize = 12f
                        setTextColor(0xFFE0F2F1.toInt())
                        setPadding(0, dp(2), 0, 0)
                    })

                    val reportMainLayout = LinearLayout(context).apply {
                        orientation = LinearLayout.VERTICAL
                    }
                    reportMainLayout.addView(reportTitleBar)

                    val reportScrollContent = LinearLayout(context).apply {
                        orientation = LinearLayout.VERTICAL
                        setPadding(0, dp(4), 0, dp(4))
                    }

                    if (items.isEmpty()) {
                        reportScrollContent.addView(TextView(context).apply {
                            text = "Tidak ada bahan dalam kategori ini."
                            textSize = 14f
                            setTextColor(0xFF757575.toInt())
                            setPadding(dp(24), dp(20), dp(24), dp(20))
                        })
                    } else {
                        items.sortedBy { it.name }.forEachIndexed { i, item ->
                            val amount = item.stockInBase
                            val minimum = item.minimumInBase
                            val unitName = item.baseUnit
                            val isLow = item.stockInBase <= item.minimumInBase

                            val row = LinearLayout(context).apply {
                                orientation = LinearLayout.VERTICAL
                                setPadding(dp(24), dp(12), dp(24), dp(12))
                            }

                            val topRow = LinearLayout(context).apply {
                                orientation = LinearLayout.HORIZONTAL
                                gravity = Gravity.CENTER_VERTICAL
                            }
                            topRow.addView(TextView(context).apply {
                                text = item.name
                                textSize = 15f
                                setTypeface(typeface, Typeface.BOLD)
                                setTextColor(0xFF26332C.toInt())
                                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
                            })

                            if (isLow) {
                                topRow.addView(TextView(context).apply {
                                    text = "RESTOCK"
                                    textSize = 10f
                                    setTypeface(typeface, Typeface.BOLD)
                                    setTextColor(Color.WHITE)
                                    setPadding(dp(6), dp(2), dp(6), dp(2))
                                    background = android.graphics.drawable.GradientDrawable().apply {
                                        setColor(0xFFC62828.toInt())
                                        cornerRadius = dp(4).toFloat()
                                    }
                                })
                            }
                            row.addView(topRow)

                            row.addView(TextView(context).apply {
                                text = "Stok: ${number(amount)} $unitName  •  Minimum: ${number(minimum)} $unitName"
                                textSize = 13f
                                setTextColor(0xFF757575.toInt())
                                setPadding(0, dp(3), 0, 0)
                            })

                            reportScrollContent.addView(row)

                            if (i < items.lastIndex) {
                                reportScrollContent.addView(View(context).apply {
                                    setBackgroundColor(0xFFE0E0E0.toInt())
                                    layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(1)).apply {
                                        marginStart = dp(24)
                                        marginEnd = dp(24)
                                    }
                                })
                            }
                        }
                    }

                    reportContainer.addView(ScrollView(context).apply {
                        addView(reportScrollContent)
                        layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(360))
                    })

                    reportMainLayout.addView(reportContainer)

                    val bottomActions = LinearLayout(context).apply {
                        orientation = LinearLayout.HORIZONTAL
                        setPadding(dp(16), dp(12), dp(16), dp(16))
                        setBackgroundColor(Color.WHITE)
                        gravity = Gravity.END
                    }

                    val btnCetak = MaterialButton(context, null, com.google.android.material.R.attr.materialButtonOutlinedStyle).apply {
                        text = "Cetak"
                        isAllCaps = false
                        setTextColor(GREEN)
                        strokeColor = ColorStateList.valueOf(GREEN)
                        cornerRadius = dp(8)
                        layoutParams = LinearLayout.LayoutParams(-2, dp(40)).apply { marginEnd = dp(8) }
                        setOnClickListener {
                            printStockReport(selected, items)
                        }
                    }
                    bottomActions.addView(btnCetak)

                    val btnKirim = MaterialButton(context, null, com.google.android.material.R.attr.materialButtonOutlinedStyle).apply {
                        text = "Kirim"
                        isAllCaps = false
                        setTextColor(GREEN)
                        strokeColor = ColorStateList.valueOf(GREEN)
                        cornerRadius = dp(8)
                        layoutParams = LinearLayout.LayoutParams(-2, dp(40)).apply { marginEnd = dp(8) }
                        setOnClickListener {
                            showShareOptionsDialog(selected, items)
                        }
                    }
                    bottomActions.addView(btnKirim)

                    val btnTutup = MaterialButton(context).apply {
                        text = "Tutup"
                        isAllCaps = false
                        setTextColor(Color.WHITE)
                        backgroundTintList = ColorStateList.valueOf(GREEN)
                        cornerRadius = dp(8)
                        layoutParams = LinearLayout.LayoutParams(-2, dp(40))
                    }
                    bottomActions.addView(btnTutup)

                    reportMainLayout.addView(bottomActions)

                    val reportDialog = MaterialAlertDialogBuilder(context)
                        .setView(reportMainLayout)
                        .create()

                    btnTutup.setOnClickListener { reportDialog.dismiss() }
                    reportDialog.show()
                }
            }

            row.addView(TextView(context).apply {
                text = category
                textSize = 15f
                setTextColor(0xFF26332C.toInt())
                layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
            })

            scrollContent.addView(row)

            if (index < categories.lastIndex) {
                // Divider line not reaching edges (inset start=24dp, end=24dp)
                scrollContent.addView(View(context).apply {
                    setBackgroundColor(0xFFE0E0E0.toInt())
                    layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(1)).apply {
                        marginStart = dp(24)
                        marginEnd = dp(24)
                    }
                })
            }
        }

        container.addView(ScrollView(context).apply {
            addView(scrollContent)
            layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(320))
        })

        mainLayout.addView(container)

        dialog = dialogBuilder
            .setView(mainLayout)
            .setNegativeButton("Batal", null)
            .create()

        dialog.show()
    }

