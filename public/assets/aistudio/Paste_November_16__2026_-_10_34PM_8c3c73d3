                    val unitName = item.baseUnit
                    val status = if (item.stockInBase <= item.minimumInBase) " ⚠️ (RESTOCK)" else ""
                    add("• *${item.name}* : ${number(amount)} $unitName (Min: ${number(min)} $unitName)$status")
                }
                add("")
                add("Total: ${items.size} bahan")
            }.joinToString("\n")

            val intent = Intent(Intent.ACTION_VIEW).apply {
                data = android.net.Uri.parse("https://api.whatsapp.com/send?text=${android.net.Uri.encode(reportText)}")
            }
            try {
                context.startActivity(intent)
            } catch (ex: Exception) {
                Toast.makeText(context, "WhatsApp tidak terpasang.", Toast.LENGTH_SHORT).show()
            }
        }

        btnEmail.setOnClickListener {
            dialog.dismiss()
            val pdfFile = generateStockReportPdf(context, category, items)
            if (pdfFile == null) {
                Toast.makeText(context, "Gagal membuat dokumen PDF.", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            try {
                val uri = androidx.core.content.FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", pdfFile)
                val intent = Intent(Intent.ACTION_SEND).apply {
                    type = "application/pdf"
                    putExtra(Intent.EXTRA_SUBJECT, "Laporan Stok · $category")
                    putExtra(Intent.EXTRA_TEXT, "Terlampir Laporan Stok untuk kategori $category.")
                    putExtra(Intent.EXTRA_STREAM, uri)
                    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                }
                context.startActivity(Intent.createChooser(intent, "Kirim Email PDF"))
            } catch (ex: Exception) {
                Toast.makeText(context, "Gagal melampirkan PDF: ${ex.localizedMessage}", Toast.LENGTH_SHORT).show()
            }
        }

        dialog.show()
    }

    private fun confirmDelete(item: IngredientRecord) {
        MaterialAlertDialogBuilder(requireContext()).setTitle("Hapus ${item.name}?")
            .setMessage("Bahan ini juga akan dihapus dari resep menu.")
            .setNegativeButton("Batal", null)
            .setPositiveButton("Hapus") { _, _ ->
                IngredientInventoryStore.deleteIngredient(requireContext(), item.id); refreshInventory()
            }.show()
    }

    private fun parseUnits(text: String): List<UnitDefinition>? {
        val result = mutableListOf<UnitDefinition>()
        text.split(",", ";", "\n").map { it.trim() }.filter { it.isNotBlank() }.forEach {
            val pair = it.split("=")
            if (pair.size != 2) return null
            val factor = pair[1].trim().replace(',', '.').toDoubleOrNull() ?: return null
            val unitName = pair[0].trim()
            if (unitName.isBlank() || factor <= 0 || result.any { entry -> entry.name.equals(unitName, true) }) return null
            result += UnitDefinition(unitName, factor)
        }
        return result.takeIf { it.isNotEmpty() }
    }

    private fun form() = LinearLayout(requireContext()).apply { orientation = LinearLayout.VERTICAL; setPadding(dp(20), dp(8), dp(20), dp(8)) }
    private fun field(title: String, input: EditText) = TextInputLayout(requireContext()).apply {
        hint = title; boxBackgroundMode = TextInputLayout.BOX_BACKGROUND_OUTLINE; boxStrokeColor = GREEN
        layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(9) }; addView(input)
    }
    private fun input(hint: String, value: String, decimal: Boolean = false) = EditText(requireContext()).apply {
        setText(value); contentDescription = hint; setSingleLine(true)
        inputType = if (decimal) InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_FLAG_DECIMAL else InputType.TYPE_CLASS_TEXT
    }
    private fun label(value: String) = TextView(requireContext()).apply { text = value; textSize = 13f; setTextColor(MUTED); setPadding(0, dp(4), 0, dp(5)) }
    private fun spinner(values: List<String>) = Spinner(requireContext()).apply {
        adapter = ArrayAdapter(requireContext(), android.R.layout.simple_spinner_dropdown_item, values)
        layoutParams = LinearLayout.LayoutParams(-1, dp(48)).apply { bottomMargin = dp(8) }
    }
    private fun numeric(edit: EditText) = edit.text.toString().trim().replace(',', '.').toDoubleOrNull()
    private fun number(value: Double) = if (value % 1.0 == 0.0) value.toLong().toString() else String.format(Locale.US, "%.3f", value).trimEnd('0').trimEnd('.')
    private fun dp(value: Int) = (value * resources.displayMetrics.density + 0.5f).toInt()

    override fun onDestroyView() { _binding = null; super.onDestroyView() }

    companion object {
        private const val GREEN = 0xFF008F89.toInt()
        private const val MUTED = 0xFF707A74.toInt()
    }
}
