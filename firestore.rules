rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all operations
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShortString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function incoming() {
      return request.resource.data;
    }

    // =========================================================================
    // 1. MULTI-CABANG & AKUN POS KASIR (Email + Username + PIN, Gate Manager+)
    // =========================================================================
    match /accounts/{accountId} {
      allow get: if isValidId(accountId);
      allow list: if true;
      allow create, update: if isValidId(accountId)
        && isValidShortString(incoming().email, 150)
        && incoming().isActive is bool;
      allow delete: if isValidId(accountId);

      match /users/{username} {
        allow get: if isValidId(accountId) && isValidId(username);
        allow list: if isValidId(accountId);
        allow create, update: if isValidId(accountId) && isValidId(username)
          && isValidShortString(incoming().username, 64)
          && isValidShortString(incoming().role, 32)
          && incoming().isActive is bool;
        allow delete: if isValidId(accountId) && isValidId(username);
      }
    }

    match /branches/{branchId} {
      allow get: if isValidId(branchId);
      allow list: if true;
      allow create, update: if isValidId(branchId)
        && isValidShortString(incoming().name, 120)
        && isValidShortString(incoming().slug, 80)
        && incoming().isActive is bool;
      allow delete: if isValidId(branchId);

      match /settings/{settingId} {
        allow get: if isValidId(branchId) && isValidId(settingId);
        allow list: if isValidId(branchId);
        allow create, update: if isValidId(branchId) && isValidId(settingId);
        allow delete: if isValidId(branchId) && isValidId(settingId);
      }

      match /categories/{categoryId} {
        allow get: if isValidId(branchId) && isValidId(categoryId);
        allow list: if isValidId(branchId);
        allow create, update: if isValidId(branchId) && isValidId(categoryId)
          && isValidShortString(incoming().name, 100);
        allow delete: if isValidId(branchId) && isValidId(categoryId);
      }

      match /products/{productId} {
        allow get: if isValidId(branchId) && isValidId(productId);
        allow list: if isValidId(branchId);
        allow create, update: if isValidId(branchId) && isValidId(productId)
          && isValidShortString(incoming().name, 150)
          && incoming().price is number
          && incoming().price >= 0;
        allow delete: if isValidId(branchId) && isValidId(productId);
      }

      match /extras/{extraId} {
        allow get: if isValidId(branchId) && isValidId(extraId);
        allow list: if isValidId(branchId);
        allow create, update: if isValidId(branchId) && isValidId(extraId)
          && isValidShortString(incoming().name, 120)
          && incoming().price is number
          && incoming().price >= 0;
        allow delete: if isValidId(branchId) && isValidId(extraId);
      }

      match /packages/{packageId} {
        allow get: if isValidId(branchId) && isValidId(packageId);
        allow list: if isValidId(branchId);
        allow create, update: if isValidId(branchId) && isValidId(packageId)
          && isValidShortString(incoming().name, 150)
          && incoming().price is number
          && incoming().price >= 0;
        allow delete: if isValidId(branchId) && isValidId(packageId);
      }

      match /orders/{orderId} {
        allow get: if isValidId(branchId) && isValidId(orderId);
        allow list: if isValidId(branchId);
        allow create: if isValidId(branchId) && isValidId(orderId)
          && isValidShortString(incoming().status, 40)
          && incoming().totalAmount is number
          && incoming().totalAmount >= 0
          && incoming().items is list;
        allow update: if isValidId(branchId) && isValidId(orderId)
          && isValidShortString(incoming().status, 40);
        allow delete: if isValidId(branchId) && isValidId(orderId);
      }
    }

    // =========================================================================
    // 2. COMPATIBILITAS KOLEKSI ROOT (UNTUK SINKRONISASI POS ANDROID LEGACY)
    // =========================================================================
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId);
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow write: if isValidId(categoryId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow write: if isValidId(productId);
    }

    match /extras/{extraId} {
      allow get: if isValidId(extraId);
      allow list: if true;
      allow write: if isValidId(extraId);
    }

    match /packages/{packageId} {
      allow get: if isValidId(packageId);
      allow list: if true;
      allow write: if isValidId(packageId);
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create: if isValidId(orderId)
        && isValidShortString(incoming().status, 40)
        && incoming().totalAmount is number
        && incoming().items is list;
      allow update: if isValidId(orderId)
        && isValidShortString(incoming().status, 40);
      allow delete: if isValidId(orderId);
    }
  }
}
